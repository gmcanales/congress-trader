POSTGRES_USER=congress
POSTGRES_PASSWORD=changeme
POSTGRES_DB=congress_trader
# Port postgres is exposed on the host (default 5432)
DB_PORT=5432

# Remote PostgreSQL server (e.g. NUC host)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── NUC (production host) only ────────────────────────────────────────────
# On the NUC, Postgres runs natively on the host rather than in compose, and
# the backend reaches it through the host gateway so the hop is loopback
# instead of a LAN round-trip:
#   DATABASE_URL=postgresql://user:password@host.docker.internal:5432/trading_db
#
# That requires the `extra_hosts` entry in docker-compose.nuc.yml, so the
# overlay must ALWAYS be applied on that host. Setting COMPOSE_FILE here is
# what guarantees it: a bare `docker compose` (and scripts/deploy.sh, which
# calls one) would otherwise silently drop the overlay and fall back to the
# base config. The failure is quiet — it only breaks if the LAN IP in
# DATABASE_URL stops resolving — so pin it rather than relying on the longer
# `-f docker-compose.yml -f docker-compose.nuc.yml` invocation being typed.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.nuc.yml

# Public leaderboard posting keys (see backend/app/routers/games.py).
# Comma-separated "slug:key" pairs. A game must send its key in the
# X-Game-Key header to POST a score. The key is embedded in client-side game
# code, so it is NOT secret — it authorizes known games and blocks drive-by
# writes, not determined cheaters. Must match the key baked into each game.
GAME_POST_KEYS=gooooose:dc8b097b042a263d1a3b2905a06bfdc4
